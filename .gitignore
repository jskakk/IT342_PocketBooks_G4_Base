# Root .gitignore for repo

# Node / frontend
/frontend/node_modules/
/frontend/dist/
/frontend/.env
/frontend/.env.local
/frontend/server/db.json

# Backend / Maven
/backend/target/
/.mvn/wrapper/maven-wrapper.jar
/backend/.idea/
/backend/*.iml
/backend/src/main/resources/application.properties
/backend/src/test/resources/application.properties

# Mobile / Gradle
/mobile/.gradle/
/mobile/app/build/
/mobile/.idea/
/mobile/*.iml
/mobile/local.properties

# IDEs
.idea/
*.iml

# OS files
.DS_Store
*.log
